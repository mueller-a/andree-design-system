---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  /** Kleine Mono-Marke im linken Rail, z. B. "Legal". */
  kicker?: string;
  lead?: string;
  /** ISO-Datum der letzten Aktualisierung, z. B. "2026-09-08". */
  updated?: string;
  /** Sprache des Inhalts, falls abweichend von der Seite (Impressum, Datenschutz). */
  lang?: string;
  noindex?: boolean;
}

const { title, description, kicker, lead, updated, lang, noindex } = Astro.props;

const updatedLocale = lang === 'de' ? 'de-DE' : 'en-GB';
const updatedLabel = updated
  ? new Intl.DateTimeFormat(updatedLocale, { dateStyle: 'long' }).format(
      new Date(updated),
    )
  : null;
const updatedWord = lang === 'de' ? 'Stand' : 'Updated';
---

<Base title={title} description={description} noindex={noindex} mainClass="textpage">
  <div class="wrap textpage__grid">
    <aside class="textpage__rail">
      {kicker && <p class="caps caps--wide rail-mark">{kicker}</p>}
      {
        updatedLabel && (
          <p class="caps textpage__updated">
            {updatedWord}
            <time datetime={updated}>{updatedLabel}</time>
          </p>
        )
      }
    </aside>

    <div class="textpage__main">
      <h1 class="textpage__title">{title}</h1>
      {lead && <p class="textpage__lead">{lead}</p>}
      <div class="prose textpage__prose" lang={lang}>
        <slot />
      </div>
    </div>
  </div>

  <style>
    .textpage__grid {
      display: grid;
      grid-template-columns: var(--meta-col) minmax(0, 1fr);
      gap: var(--space-12);
      align-items: start;
      padding-block: var(--space-24);
    }

    .textpage__updated {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      margin-block-start: var(--space-8);
      color: var(--muted);
    }

    .textpage__main {
      max-width: var(--measure-wide);
    }

    .textpage__title {
      max-width: 24ch;
    }

    .textpage__lead {
      margin-block: var(--space-8);
      font-size: var(--step-1);
      line-height: 1.6;
      color: var(--text);
    }

    .textpage__prose {
      max-width: none;
    }

    @media (max-width: 48rem) {
      .textpage__grid {
        grid-template-columns: 1fr;
        gap: var(--space-6);
      }

      .textpage__updated {
        margin-block-start: var(--space-4);
      }
    }
  </style>
</Base>
