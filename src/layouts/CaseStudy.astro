---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import CaseHeader from '../components/CaseHeader.astro';
import OutcomeList from '../components/OutcomeList.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const d = entry.data;
const ogImage = `/og/${entry.id}.png`;

const meta: Array<[string, string]> = [
  ['Client', d.client],
  ['Sector', d.sector],
  ['Role', d.role],
  ['Period', d.period],
  ['Team', d.team],
];

// Nächste Case Study für den "Next case study"-Link (nach order, zyklisch).
const all = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;
---

<Base title={d.title} description={d.summary} ogImage={ogImage} mainClass="case">
  <article class="case">
    <div class="wrap case__head">
      <CaseHeader
        title={d.title}
        client={d.client}
        summary={d.summary}
        index={d.order}
        confidential={d.confidential}
      />
    </div>

    <div class="wrap">
      <dl class="case__meta">
        {
          meta.map(([k, v]) => (
            <div class="case__meta-cell">
              <dt class="caps">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="wrap">
      {
        d.confidential ? (
          <div class="case__leitbild placeholder" role="img" aria-label={d.coverAlt}>
            <span class="caps">Confidential — surfaces abstracted</span>
          </div>
        ) : (
          <div class="case__leitbild">
            <Picture
              src={d.cover}
              alt={d.coverAlt}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[720, 1080, 1440, 1920]}
              sizes="(min-width: 77.5rem) 1120px, 100vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }
    </div>

    <div class="wrap case__outcome">
      <OutcomeList items={d.outcome} />
    </div>

    <div class="wrap case__chapters">
      <slot />
    </div>

    {
      d.reference && (
        <p class="wrap case__ref">
          <span class="caps caps--wide">Reference</span>
          <a href={d.reference.url} rel="external">
            {d.reference.label}
          </a>
        </p>
      )
    }

    {
      next && (
        <a class="case__next" href={`/work/${next.id}`}>
          <span class="case__next-body">
            <span class="caps caps--wide">Next case study</span>
            <span class="case__next-title">{next.data.title}</span>
          </span>
          <span class="case__next-arrow caps--accent" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .case__head {
    padding-block: var(--space-14) var(--space-14);
  }

  /* ---------- Metaband ---------- */

  .case__meta {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-14);
    background: var(--rule);
  }

  .case__meta-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4);
    background: var(--surface-raised);
  }

  .case__meta-cell dt {
    margin: 0;
  }

  .case__meta-cell dd {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink);
  }

  @media (max-width: 60rem) {
    .case__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .case__meta {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Leitbild ---------- */

  .case__leitbild {
    aspect-ratio: 2.4;
    overflow: hidden;
    background: var(--placeholder);
  }

  .case__leitbild :global(picture),
  .case__leitbild :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .case__leitbild.placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 2.4;
    color: var(--ink-muted);
  }

  @media (max-width: 48rem) {
    .case__leitbild,
    .case__leitbild.placeholder {
      aspect-ratio: 16 / 10;
    }
  }

  /* ---------- Outcome + Kapitel ---------- */

  .case__outcome {
    padding-block-start: var(--space-16);
  }

  .case__chapters {
    padding-block-start: var(--space-8);
  }

  .case__chapters :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent-ink);
    text-underline-offset: 0.18em;
  }

  .case__chapters :global(ul),
  .case__chapters :global(ol) {
    padding-inline-start: var(--space-6);
  }

  .case__chapters :global(li + li) {
    margin-block-start: var(--space-2);
  }

  /* Jedes Kapitel: Mono-Marke links, Text rechts (remark-sectionize). */
  .case__chapters :global(section) {
    display: grid;
    grid-template-columns: var(--meta-col) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: start;
    padding-block-start: var(--space-16);
  }

  .case__chapters :global(section > *) {
    grid-column: 2;
    max-width: var(--measure);
  }

  .case__chapters :global(section > h2) {
    grid-column: 1;
    margin: 0;
    padding-block-start: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps-wide);
    color: var(--ink-muted);
  }

  .case__chapters :global(section > h3) {
    font-size: var(--step-2);
    font-weight: var(--weight-subhead);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  .case__chapters :global(section > * + *) {
    margin-block-start: var(--space-5, 1.25rem);
  }

  .case__chapters :global(section p) {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--ink-muted);
  }

  @media (max-width: 48rem) {
    .case__chapters :global(section) {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .case__chapters :global(section > *) {
      grid-column: 1;
    }

    .case__chapters :global(section > h2) {
      grid-column: 1;
      padding-block-start: 0;
    }
  }

  /* ---------- Next case study ---------- */

  .case__next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-block-start: var(--space-24);
    padding: var(--space-10) var(--gutter);
    border-block-start: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--motion-base) var(--ease);
  }

  .case__next:hover {
    background: var(--surface-raised);
  }

  .case__next-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case__next-title {
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
  }

  .case__next-arrow {
    font-size: var(--step-2);
    color: var(--accent-ink);
  }

  .case__ref {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
    margin-block-start: var(--space-16);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--rule);
  }

  .case__ref a {
    color: var(--accent-ink);
    text-decoration-color: var(--accent-ink);
  }
</style>
