---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import CaseHeader from '../components/CaseHeader.astro';
import OutcomeList from '../components/OutcomeList.astro';
import JsonLd from '../components/JsonLd.astro';
import { creativeWorkJsonLd } from '../lib/jsonld';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const d = entry.data;
const ogImage = `/og/${entry.id}.png`;

const meta: Array<[string, string]> = [
  ['Client', d.client],
  ['Sector', d.sector],
  ['Role', d.role],
  ['Period', d.period],
  ['Team', d.team],
];

// Nächste Case Study für den "Next case study"-Link (nach order, zyklisch).
const all = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;
---

<Base
  title={d.title}
  description={d.summary}
  ogImage={ogImage}
  noindex={d.gate === 'full'}
  mainClass="case"
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={`/work/${entry.id}.md`} title="Markdown version" />
    <JsonLd data={creativeWorkJsonLd(entry)} />
  </Fragment>
  <article class="case">
    <div class="wrap case__head">
      <CaseHeader
        title={d.title}
        client={d.client}
        summary={d.summary}
        index={d.order}
        confidential={d.confidential}
      />
    </div>

    <div class="wrap">
      <dl class="case__meta">
        {
          meta.map(([k, v]) => (
            <div class="case__meta-cell">
              <dt class="caps">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="wrap">
      <div class="case__leitbild">
        <Picture
          src={d.cover}
          alt={d.coverAlt}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[720, 1080, 1440, 1920]}
          sizes="(min-width: 105rem) 1560px, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          pictureAttributes={
            d.coverDark ? { class: 'leitbild__variant leitbild__variant--light' } : undefined
          }
        />
        {
          d.coverDark && (
            <Picture
              src={d.coverDark}
              alt={d.coverAlt}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[720, 1080, 1440, 1920]}
              sizes="(min-width: 105rem) 1560px, 100vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              pictureAttributes={{ class: 'leitbild__variant leitbild__variant--dark' }}
            />
          )
        }
      </div>
    </div>

    <div class="wrap case__outcome">
      <OutcomeList items={d.outcome} />
    </div>

    <!-- md-twin:start -->
    <div class="wrap case__chapters">
      <slot />
    </div>

    {
      d.reference && (
        <p class="wrap case__ref">
          <span class="caps caps--wide">Reference</span>
          <a
            href={d.reference.url}
            target="_blank"
            rel="external noopener noreferrer"
          >
            {d.reference.label}
          </a>
        </p>
      )
    }
    <!-- md-twin:end -->

    {
      next && (
        <a class="case__next" href={`/work/${next.id}`}>
          <span class="case__next-body">
            <span class="caps caps--wide">Next case study</span>
            <span class="case__next-title">{next.data.title}</span>
          </span>
          <span class="case__next-arrow caps--accent" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .case__head {
    padding-block: var(--space-14) var(--space-14);
  }

  /* ---------- Metaband ---------- */

  .case__meta {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 var(--space-14);
    background: var(--border);
  }

  .case__meta-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4);
    background: var(--bg);
  }

  .case__meta-cell dt {
    margin: 0;
  }

  .case__meta-cell dd {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink);
  }

  @media (max-width: 60rem) {
    .case__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .case__meta {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Leitbild ---------- */

  .case__leitbild {
    background: var(--placeholder);
  }

  .case__leitbild :global(picture) {
    display: block;
  }

  .case__leitbild :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* Hell/Dunkel-Cover, gegenläufig zum Seiten-Theme wie bei Figure.astro:
     coverDark im Light Mode, cover im Dark Mode, sonst verschwimmt der
     jeweils helle Bildrand mit dem gleichfarbigen Seitengrund. */
  .case__leitbild :global(picture.leitbild__variant--light) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) picture.leitbild__variant--dark) {
      display: none;
    }
    :global(:root:not([data-theme='light']) picture.leitbild__variant--light) {
      display: block;
    }
  }

  :global(:root[data-theme='dark'] picture.leitbild__variant--dark) {
    display: none;
  }
  :global(:root[data-theme='dark'] picture.leitbild__variant--light) {
    display: block;
  }


  /* ---------- Outcome + Kapitel ---------- */

  .case__outcome {
    padding-block-start: var(--space-16);
  }

  .case__chapters {
    padding-block-start: var(--space-8);
  }

  .case__chapters :global(ul),
  .case__chapters :global(ol) {
    padding-inline-start: var(--space-6);
  }

  .case__chapters :global(li + li) {
    margin-block-start: var(--space-2);
  }

  /* Jedes Kapitel: Mono-Marke links, Text rechts (remark-sectionize). */
  .case__chapters :global(section) {
    display: grid;
    grid-template-columns: var(--meta-col) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: start;
    padding-block-start: var(--space-12);
  }

  .case__chapters :global(section:first-of-type) {
    padding-block-start: 0;
  }

  .case__chapters :global(section > *) {
    grid-column: 2;
    max-width: var(--measure-wide);
  }

  .case__chapters :global(section > h2) {
    grid-column: 1;
    width: max-content;
    max-width: 100%;
    margin: 0;
    padding-block: var(--space-1) var(--space-2);
    border-block-end: var(--rail) solid var(--mark);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps-wide);
    color: var(--text);
  }

  .case__chapters :global(section > h3) {
    font-size: var(--step-2);
    font-weight: var(--weight-subhead);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  /* Erstes Element in Spalte 2 (die ###-Kapitelüberschrift) fluchtet mit der
     Mono-Marke; Abstand gibt's erst zwischen den Elementen danach. */
  .case__chapters :global(section > h2 + *) {
    margin-block-start: 0;
  }

  .case__chapters :global(section > h2 + * ~ *) {
    margin-block-start: var(--space-3);
  }

  /* Kapitel-Trenner: Figure mit `bleed` nutzt die volle Sektionsbreite statt
     der Textspalte, auch wenn sie als erstes Element nach der Mono-Marke
     steht. */
  .case__chapters :global(section > .figure--bleed) {
    grid-column: 1 / -1;
    max-width: none;
    margin-block-start: var(--space-8);
  }

  .case__chapters :global(section p) {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--text);
  }

  @media (max-width: 48rem) {
    .case__chapters :global(section) {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .case__chapters :global(section > *) {
      grid-column: 1;
    }

    .case__chapters :global(section > h2) {
      grid-column: 1;
      padding-block-start: 0;
    }
  }

  /* ---------- Next case study ---------- */

  .case__next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-block-start: var(--space-24);
    padding: var(--space-10) var(--gutter);
    border-block-start: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--motion-base) var(--ease);
  }

  .case__next:hover {
    background: var(--bg);
  }

  .case__next-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case__next-title {
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
  }

  .case__next-arrow {
    font-size: var(--step-2);
    color: var(--accent);
  }

  .case__ref {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
    margin-block-start: var(--space-16);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--border);
  }

  .case__ref a {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
