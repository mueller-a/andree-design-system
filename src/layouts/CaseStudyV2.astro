---
/**
 * Geteilte Hülle für die Case-Study-Seiten, komponiert aus den Atomen in
 * src/components/ (CaseHero, Figure/GatedImage, ReferenceLink, NextCase).
 * Übernimmt Titel/Summary/Meta/Cover/Reference direkt aus der
 * Content-Collection-Entry, keine Neueingabe pro Seite.
 *
 * Erwartet folgende Slots:
 * - `tldr`: die <Chapter label="TL;DR">-Komponente der aufrufenden Seite
 *   (Lead-Absatz + <Triptych/> + optional <StatRow/>).
 * - `afterTldr` (optional): z. B. eine <Timeline />, zwischen TL;DR und
 *   Cover-Bild. Nur von Seiten genutzt, die das brauchen (z. B. PRINCE).
 * - Standard-Slot: die <Chapter />-Blöcke.
 *
 * Jede Seite, die dieses Layout nutzt, braucht weiterhin ihre eigene feste
 * Route in src/pages/work/<slug>.astro (siehe dort für die Begründung,
 * besonders `export const prerender = false` bei gate !== 'none').
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Figure from '../components/Figure.astro';
import GatedImage from '../components/GatedImage.astro';
import JsonLd from '../components/JsonLd.astro';
import CaseHero from '../components/CaseHero.astro';
import ReferenceLink from '../components/ReferenceLink.astro';
import NextCase from '../components/NextCase.astro';

interface NavItem {
  href: string;
  label: string;
}

interface SiteInfo {
  name: string;
  role: string;
  url: string;
  lang: string;
  locale: string;
  description: string;
  ogDefault: string;
  email: string;
  linkedin: string;
}

interface Props {
  entry: CollectionEntry<'work'>;
  site: SiteInfo;
  nav: NavItem[];
  /** Weitergereicht an Base. */
  navAliases?: Record<string, string[]>;
  footerNav: NavItem[];
  /** CreativeWork-JSON-LD, von der Seite berechnet (bindet das Layout nicht
   * an die App-spezifische Content-Collection). */
  jsonLd: Record<string, unknown>;
}

const { entry, site, nav, navAliases, footerNav, jsonLd } = Astro.props;
const d = entry.data;

const all = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;

const meta: Array<[string, string]> = [
  ['Client', d.client],
  ['Sector', d.sector],
  ['Role', d.role],
  ['Period', d.period],
  ['Team', d.team],
];

const ogImage = `/og/${entry.id}.png`;
const hasAfterTldr = Astro.slots.has('afterTldr');
---

<Base
  site={site}
  nav={nav}
  navAliases={navAliases}
  footerNav={footerNav}
  title={d.title}
  description={d.summary}
  ogImage={ogImage}
  noindex={d.gate === 'full'}
  mainClass="case-study-page"
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={`/work/${entry.id}.md`} title="Markdown version" />
    <JsonLd data={jsonLd} />
  </Fragment>
  <div class="wrap">
    <article class="case-study">
      <CaseHero
        kicker={`Case study ${String(d.order).padStart(2, '0')} · ${d.client}`}
        title={d.title}
        lead={d.summary}
        meta={meta}
      />

      <!-- md-twin:start -->
      <slot name="tldr" />

      {
        hasAfterTldr && (
          <div class="case-study__after-tldr">
            <div class="case-study__after-tldr-spacer" aria-hidden="true" />
            <div class="case-study__after-tldr-content">
              <slot name="afterTldr" />
            </div>
          </div>
        )
      }

      <div class="case-study__cover">
        {
          d.gate === 'none' ? (
            <Figure src={d.cover} srcDark={d.coverDark} alt={d.coverAlt} lazy={false} variant="bleed" />
          ) : (
            <GatedImage src={`${entry.id}/cover.png`} alt={d.coverRealAlt ?? d.coverAlt} lazy={false} variant="bleed" />
          )
        }
      </div>

      <slot />

      {d.reference && <ReferenceLink href={d.reference.url} label={d.reference.label} />}
      <!-- md-twin:end -->

      {next && <NextCase href={`/work/${next.id}`} title={next.data.title} />}
    </article>
  </div>
</Base>

<style>
  .case-study {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding-block: var(--space-10) var(--space-32);
  }

  /* Spiegelt Triptychs Label-Spalte/Body-Aufteilung (1 1 200px / 999 1
     560px), damit darunter platzierter Slot-Inhalt (z. B. Timeline) exakt
     unter den TL;DR-Spalten anfängt, nicht an der vollen Breite. */
  .case-study__after-tldr {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-16);
  }

  .case-study__after-tldr-spacer {
    flex: 1 1 200px;
    max-width: var(--chapter-label-col);
  }

  .case-study__after-tldr-content {
    flex: 999 1 560px;
    min-width: 0;
  }

  .case-study__cover {
    margin-block-start: calc(var(--space-24) * -1 + var(--space-8));
    max-width: 68.75rem;
    margin-inline: auto;
  }
</style>
