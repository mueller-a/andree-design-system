---
/**
 * Schriften, Gewichte, die allgemeine --step-Skala und die 18 Case-Study-
 * Stufen (--text-*). Größen kommen aus tokens.css; Gewicht und Zeilenhöhe
 * sind keine Tokens, sie sind aus der Tabelle der Portfolio-Seite
 * /design-system übernommen (Spezifikation). Wo Komponenten davon abweichen,
 * listet die Seite das, zur Build-Zeit aus dem CSS ermittelt.
 */
import FoundationLayout from '../../docs/FoundationLayout.astro';
import TableScroll from '../../docs/TableScroll.astro';
import { token, tokensWithPrefix } from '../../docs/tokens';
import { families, stepUse, caseScale, sizeRange, specDeviations } from '../../docs/foundation-data';

const weights = tokensWithPrefix('weight-');

const steps = tokensWithPrefix('step-');

const missing = tokensWithPrefix('text-').filter((n) => !caseScale.some(([s]) => `text-${s}` === n));
if (missing.length) throw new Error(`typography: --${missing.join(', --')} fehlt in der Tabelle`);

/* Abweichungen der Komponenten von der Spezifikation. */
const deviations = specDeviations();

const leading = tokensWithPrefix('leading-');
const tracking = tokensWithPrefix('tracking-');

const range = sizeRange;
const SAMPLE = 'Readable at every size';
---

<FoundationLayout slug="typography">
  <section class="docs-section" aria-labelledby="families">
    <h2 id="families">Font families</h2>
    <TableScroll label="Font families">
      <table class="docs-table">
        <caption>Font family tokens</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Stack</th>
            <th scope="col">Use</th>
            <th scope="col">Sample</th>
          </tr>
        </thead>
        <tbody>
          {
            families.map(([name, use]) => (
              <tr>
                <th scope="row"><code>--{name}</code></th>
                <td><code>{token(name)}</code></td>
                <td class="docs-table__text">{use}</td>
                <td style={`font-family: var(--${name})`}>{SAMPLE}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </TableScroll>
  </section>

  <section class="docs-section" aria-labelledby="weights">
    <h2 id="weights">Weights</h2>
    <table class="docs-table">
      <caption>Font weight tokens</caption>
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Value</th>
          <th scope="col">Sample</th>
        </tr>
      </thead>
      <tbody>
        {
          weights.map((name) => (
            <tr>
              <th scope="row"><code>--{name}</code></th>
              <td>{token(name)}</td>
              <td style={`font-weight: var(--${name}); font-size: var(--step-1)`}>{SAMPLE}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="docs-section" aria-labelledby="steps">
    <h2 id="steps">General scale</h2>
    <p class="docs-note">
      The site-wide fluid scale, used by the header, the footer and the page
      templates. Each step grows between its minimum and maximum with the
      viewport width.
    </p>
    <TableScroll label="General type scale" size="medium">
      <table class="docs-table">
        <caption>The --step type scale</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Value</th>
            <th scope="col">Size</th>
            <th scope="col">Use</th>
          </tr>
        </thead>
        <tbody>
          {
            steps.map((name) => (
              <tr>
                <th scope="row"><code>--{name}</code></th>
                <td><code>{token(name)}</code></td>
                <td>{range(token(name))}</td>
                <td>{stepUse[name] ?? ''}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </TableScroll>
  </section>

  <section class="docs-section" aria-labelledby="case-scale">
    <h2 id="case-scale">Case study scale</h2>
    <p class="docs-note">
      Eighteen sizes named after their use, added to the general scale for the
      case study components. Size comes from the token. Weight and line height
      are not tokens: this table gives the values from the original
      specification, and each component sets them itself.
    </p>
    <TableScroll label="Case study type scale">
      <table class="docs-table">
        <caption>The --text type scale</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Value</th>
            <th scope="col">Size</th>
            <th scope="col">Weight</th>
            <th scope="col">Line height</th>
            <th scope="col">Use</th>
          </tr>
        </thead>
        <tbody>
          {
            caseScale.map(([name, weight, lh, use]) => (
              <tr>
                <th scope="row"><code>--text-{name}</code></th>
                <td><code>{token(`text-${name}`)}</code></td>
                <td>{range(token(`text-${name}`))}</td>
                <td>{weight}</td>
                <td>{lh || 'not set'}</td>
                <td class="docs-table__text">{use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </TableScroll>
    {
      deviations.length > 0 && (
        <>
          <p class="docs-note">
            Components that set a different weight or line height for a size,
            found in their CSS when the site is built:
          </p>
          <TableScroll label="Differences from the specification">
            <table class="docs-table">
              <caption>Where components differ from the specification</caption>
              <thead>
                <tr>
                  <th scope="col">Component</th>
                  <th scope="col">Size</th>
                  <th scope="col">Property</th>
                  <th scope="col">Specification</th>
                  <th scope="col">Actual</th>
                </tr>
              </thead>
              <tbody>
                {deviations.map((d) => (
                  <tr>
                    <th scope="row">{d.file.replace(/\.(astro|css)$/, '')}</th>
                    <td><code>--text-{d.token}</code></td>
                    <td>{d.what}</td>
                    <td>{d.spec}</td>
                    <td>{d.actual}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </TableScroll>
        </>
      )
    }
  </section>

  <section class="docs-section" aria-labelledby="specimens">
    <h2 id="specimens">Specimens</h2>
    <p class="docs-note">
      Each case study size set live, with its weight and line height.
    </p>
    <ul class="docs-specimens" role="list">
      {
        caseScale.map(([name, weight, lh]) => (
          <li class="docs-specimen">
            <p class="docs-kicker"><code>--text-{name}</code></p>
            <p
              class="docs-specimen__sample"
              style={`font-size: var(--text-${name}); font-weight: ${weight};${lh ? ` line-height: ${lh};` : ''}`}
            >
              {SAMPLE}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="docs-section" aria-labelledby="leading">
    <h2 id="leading">Leading and tracking</h2>
    <table class="docs-table">
      <caption>Line height and letter spacing tokens</caption>
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col">Value</th>
        </tr>
      </thead>
      <tbody>
        {
          [...leading, ...tracking].map((name) => (
            <tr>
              <th scope="row"><code>--{name}</code></th>
              <td><code>{token(name)}</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</FoundationLayout>

<style>
  .docs-specimens {
    display: grid;
    gap: var(--space-8);
    margin: 0;
  }

  .docs-specimen {
    display: grid;
    gap: var(--space-2);
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--border);
  }

  .docs-specimen__sample {
    margin: 0;
    color: var(--ink);
  }
</style>
