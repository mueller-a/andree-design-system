---
/**
 * Seitennavigation der Doku: Overview, Foundations, die dokumentierten
 * Komponenten alphabetisch, darunter der Hinweis auf die noch offenen.
 *
 * Wird zweimal gerendert (Disclosure unter 64rem, Seitenleiste ab 64rem),
 * von denen je Breite nur eine angezeigt wird. `prefix` hält die IDs der
 * beiden Instanzen eindeutig.
 *
 * Das Filterfeld filtert nur die Komponentenliste dieser Navigation, nach
 * dem Namen: Summaries stehen hier nicht, ein Treffer über die Summary wäre
 * nicht nachvollziehbar. Ohne JavaScript ausgeblendet.
 */
import { componentList } from './components';
import { foundations } from './site';

interface Props {
  prefix: string;
  /** ID des <nav>, Ziel des Skip-Links bzw. von aria-controls. */
  id: string;
}
const { prefix, id } = Astro.props;

const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const path = norm(Astro.url.pathname);
const current = (href: string) => (norm(href) === path ? 'page' : undefined);

const entries = await componentList();
const documented = entries.filter((e) => e.doc);
const pending = entries.length - documented.length;
---

<nav class="docs-nav" id={id} aria-label="Documentation">
  <ul class="docs-nav__list" role="list">
    <li>
      <a class="docs-nav__link" href="/" aria-current={current('/')}>Overview</a>
    </li>
    <li>
      <span class="docs-nav__group" id={`${prefix}-foundations`}>Foundations</span>
      <ul class="docs-nav__list" role="list" aria-labelledby={`${prefix}-foundations`}>
        {
          foundations.map((f) => (
            <li>
              <a
                class="docs-nav__link"
                href={`/foundations/${f.slug}`}
                aria-current={current(`/foundations/${f.slug}`)}
              >
                {f.title}
              </a>
            </li>
          ))
        }
      </ul>
    </li>
    <li>
      <span class="docs-nav__group" id={`${prefix}-components`}>Components</span>
      <div class="docs-nav__filter" data-nav-filter hidden>
        <label for={`${prefix}-filter`}>Filter components</label>
        <input type="search" id={`${prefix}-filter`} autocomplete="off" />
        <p class="docs-nav__count" role="status" data-nav-count></p>
      </div>
      <ul class="docs-nav__list" role="list" aria-labelledby={`${prefix}-components`} data-nav-list>
        {
          documented.map(({ doc }) => (
            <li data-name={doc!.data.name.toLowerCase()}>
              <a
                class="docs-nav__link"
                href={`/components/${doc!.data.slug}`}
                aria-current={current(`/components/${doc!.data.slug}`)}
              >
                {doc!.data.name}
              </a>
            </li>
          ))
        }
      </ul>
      {
        pending > 0 && (
          <a class="docs-nav__more" href="/#components">
            {pending} more not documented yet
          </a>
        )
      }
    </li>
  </ul>
</nav>

<script>
  // Ein Filter je Navigations-Instanz. Trefferzahl nach jeder Änderung an die
  // Live-Region; beim ersten Setzen keine Ansage.
  for (const nav of document.querySelectorAll<HTMLElement>('.docs-nav')) {
    const box = nav.querySelector<HTMLElement>('[data-nav-filter]');
    const input = box?.querySelector<HTMLInputElement>('input');
    const count = box?.querySelector<HTMLElement>('[data-nav-count]');
    const list = nav.querySelector<HTMLElement>('[data-nav-list]');
    if (!box || !input || !count || !list) continue;

    const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    const apply = (announce: boolean) => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const visible = query === '' || (item.dataset.name ?? '').includes(query);
        item.hidden = !visible;
        if (visible) shown += 1;
      }
      const text = `${shown} of ${items.length} components`;
      if (announce || count.textContent === '') count.textContent = text;
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => apply(true), 300);
    });
    apply(false);
    box.hidden = false;
  }
</script>
