---
/**
 * Unterkapitel innerhalb eines langen Chapters (z. B. Approach in vier
 * SubSections). Siehe DESIGN_SYSTEM_SPEC.md (DMPK-Handoff).
 */
interface Props {
  /** z. B. "02.1" */
  num: string;
  title: string;
}
const { num, title } = Astro.props;
---

<div class="subsection">
  <div class="subsection__head">
    <span class="subsection__num">{num}</span>
    <h3 class="subsection__title">{title}</h3>
  </div>
  <div class="subsection__body">
    <slot />
  </div>
</div>

<style>
  .subsection {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    border-top: 1px solid var(--border);
    padding-top: var(--space-10);
    margin-top: var(--space-6);
  }

  .subsection__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
  }

  .subsection__num {
    font-family: var(--font-mono);
    font-size: var(--text-label-l);
    letter-spacing: var(--tracking-case-caps);
    color: var(--accent);
  }

  .subsection__title {
    margin: 0;
    font-size: 1.625rem;
    font-weight: var(--weight-body);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .subsection__body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
</style>
