---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Bild mit optionaler Bildunterschrift. `alt` ist Pflicht.
 * Dekorative Bilder: `decorative` setzen – dann alt="" und role="presentation".
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  decorative?: boolean;
  /** Erstes Bild above the fold: auf false setzen für eager loading. */
  lazy?: boolean;
  widths?: number[];
  sizes?: string;
  /**
   * Als Kapitel-Trenner: bricht aus der Zweispalten-Kapitelspalte aus und
   * nutzt die volle Breite von `.case__chapters section` statt der
   * Textspalte. Nur innerhalb von CaseStudy-Kapiteln wirksam.
   */
  bleed?: boolean;
}

const {
  src,
  alt,
  caption,
  decorative = false,
  lazy = true,
  widths = [640, 960, 1280, 1600],
  sizes = '(min-width: 76rem) 1024px, 100vw',
  bleed = false,
} = Astro.props;

if (!decorative && alt.trim() === '') {
  throw new Error(
    'Figure: leeres alt ist nur mit `decorative` erlaubt. Sinnvollen Alt-Text ergänzen.',
  );
}
---

<figure class:list={['figure', { 'figure--bleed': bleed }]}>
  <Picture
    src={src}
    alt={decorative ? '' : alt}
    role={decorative ? 'presentation' : undefined}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    widths={widths}
    sizes={sizes}
    loading={lazy ? 'lazy' : 'eager'}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--space-12);
  }

  .figure :global(picture) {
    display: block;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    background: var(--placeholder);
  }

  /* Bleed-Bilder sind oft transparent (Device-Mockups); ein bewusster
     Flächenton statt des Lade-Streifenmusters. */
  .figure--bleed :global(img) {
    box-sizing: border-box;
    background: var(--surface-raised);
    padding: var(--space-8);
  }

  figcaption {
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-muted);
    max-width: var(--measure);
  }
</style>
