---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Bild mit optionaler Bildunterschrift. `alt` ist Pflicht.
 * Dekorative Bilder: `decorative` setzen – dann alt="" und role="presentation".
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  decorative?: boolean;
  /** Erstes Bild above the fold: auf false setzen für eager loading. */
  lazy?: boolean;
  widths?: number[];
  sizes?: string;
  /**
   * Als Kapitel-Trenner: bricht aus der Zweispalten-Kapitelspalte aus und
   * nutzt die volle Breite von `.case__chapters section` statt der
   * Textspalte. Nur innerhalb von CaseStudy-Kapiteln wirksam.
   */
  bleed?: boolean;
  /**
   * Dunkle Variante desselben Inhalts (z. B. ein Diagramm mit dunklem statt
   * hellem Grund). Wenn gesetzt, rendert Figure beide Bilder und blendet die
   * passende Variante rein per CSS um, exakt nach demselben `data-theme`-
   * Mechanismus wie die Farb-Tokens, kein JavaScript nötig. Die Umschaltung
   * ist bewusst gegenläufig zum Seiten-Theme: `srcDark` zeigt im Light Mode
   * (Kontrast zum hellen Seitengrund), `src` im Dark Mode (Kontrast zum
   * dunklen Seitengrund) – sonst verschwimmt der jeweils helle Bildrand mit
   * dem gleichfarbigen Seitengrund.
   */
  srcDark?: ImageMetadata;
}

const {
  src,
  alt,
  caption,
  decorative = false,
  lazy = true,
  widths = [640, 960, 1280, 1600, 2000],
  sizes = '(min-width: 76rem) 1024px, 100vw',
  bleed = false,
  srcDark,
} = Astro.props;

if (!decorative && alt.trim() === '') {
  throw new Error(
    'Figure: leeres alt ist nur mit `decorative` erlaubt. Sinnvollen Alt-Text ergänzen.',
  );
}
---

<figure class:list={['figure', { 'figure--bleed': bleed }]}>
  <Picture
    src={src}
    alt={decorative ? '' : alt}
    role={decorative ? 'presentation' : undefined}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    widths={widths}
    sizes={sizes}
    loading={lazy ? 'lazy' : 'eager'}
    decoding="async"
    pictureAttributes={
      srcDark ? { class: 'figure__variant figure__variant--light' } : undefined
    }
  />
  {
    srcDark && (
      <Picture
        src={srcDark}
        alt={decorative ? '' : alt}
        role={decorative ? 'presentation' : undefined}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        widths={widths}
        sizes={sizes}
        loading={lazy ? 'lazy' : 'eager'}
        decoding="async"
        pictureAttributes={{ class: 'figure__variant figure__variant--dark' }}
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--space-12);
  }

  .figure :global(picture) {
    display: block;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    background: var(--placeholder);
  }

  /* Bleed-Bilder sind oft transparent (Device-Mockups); transparent statt
     des Lade-Streifenmusters, damit der echte Seitenhintergrund durchscheint. */
  .figure--bleed :global(img) {
    box-sizing: border-box;
    background: transparent;
    padding: var(--space-8);
  }

  /* Hell/Dunkel-Bildpaar: bewusst gegenläufig zum Seiten-Theme, nicht
     passend dazu. `src` (heller Bildgrund) zeigt im Dark Mode, wo er als
     Fläche gegen den dunklen Seitengrund abhebt; `srcDark` (dunkler
     Bildgrund) zeigt im Light Mode, sonst verschwimmt sein heller Rand mit
     dem hellen Seitengrund ("White Space"-Problem). Default zeigt darum
     srcDark, Umschaltung folgt sonst dem Theme-Vertrag aus tokens.css
     (System via prefers-color-scheme, manueller Umschalter über data-theme
     gewinnt in beide Richtungen). */
  .figure :global(picture.figure__variant--light) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) picture.figure__variant--dark) {
      display: none;
    }
    :global(:root:not([data-theme='light']) picture.figure__variant--light) {
      display: block;
    }
  }

  :global(:root[data-theme='dark'] picture.figure__variant--dark) {
    display: none;
  }
  :global(:root[data-theme='dark'] picture.figure__variant--light) {
    display: block;
  }

  figcaption {
    margin-block-start: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--text);
  }
</style>
