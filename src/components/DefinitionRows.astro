---
/** `body` darf ein einzelnes <strong> enthalten (eigener, fest verdrahteter Text). */
interface Row {
  term: string;
  body: string;
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---

<dl class="definition-rows">
  {
    rows.map((row) => (
      <div class="definition-rows__row">
        <dt class="definition-rows__term">{row.term}</dt>
        <dd class="definition-rows__body" set:html={row.body} />
      </div>
    ))
  }
</dl>

<style>
  .definition-rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .definition-rows__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-10);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
  }

  .definition-rows__term {
    margin: 0;
    flex: 0 0 200px;
    padding-top: 5px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-case-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .definition-rows__body {
    margin: 0;
    flex: 1 1 320px;
    font-size: var(--text-body-s);
    line-height: 1.6;
    color: var(--text);
  }

  .definition-rows__body :global(strong) {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
</style>
