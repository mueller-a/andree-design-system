---
/** Maximal 4 Kennzahlen. */
interface Stat {
  value: string;
  label: string;
}
interface Props {
  items: Stat[];
}
const { items } = Astro.props;
---

<div class="stat-row">
  {
    items.map((stat) => (
      <div class="stat-row__item">
        <span class="stat-row__value">{stat.value}</span>
        <span class="stat-row__label">{stat.label}</span>
      </div>
    ))
  }
</div>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-6);
  }

  .stat-row__item {
    border-top: 1px solid var(--mark);
    padding-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stat-row__value {
    font-weight: var(--weight-subhead);
    font-size: var(--text-stat);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .stat-row__label {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
