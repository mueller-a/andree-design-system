---
import FlowChips from './FlowChips.astro';

interface Step {
  number: string;
  /** Ohne Titel entfällt die <h3>-Zeile, nur die Nummer + der Text bleiben
   * (z. B. für eine knappe Outcome-Liste ohne eigene Überschrift pro Punkt). */
  title?: string;
  body: string;
  /** Variante `loop`: statt Fließtext eine FlowChips-Reihe. */
  chips?: string[];
  loop?: boolean;
}
interface Props {
  /** Optionaler Kopf-Label. */
  label?: string;
  steps: Step[];
}
const { label, steps } = Astro.props;
---

<div class="process-steps">
  {label && <p class="process-steps__label">{label}</p>}
  <ol class="process-steps__list" role="list">
    {
      steps.map((step) => (
        <li class="process-steps__item">
          <span class="process-steps__number" aria-hidden="true">
            {step.number}
          </span>
          <div class="process-steps__content">
            {step.title && <h3 class="process-steps__title">{step.title}</h3>}
            {step.chips ? (
              <FlowChips chips={step.chips} loop={step.loop} />
            ) : (
              <p class="process-steps__body">{step.body}</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process-steps__label {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-case-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .process-steps__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .process-steps__item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border);
  }

  .process-steps__number {
    font-weight: var(--weight-subhead);
    font-size: var(--text-step-num);
    line-height: 1;
    color: var(--accent);
  }

  .process-steps__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .process-steps__title {
    margin: 0;
    font-size: var(--text-title-l);
    font-weight: var(--weight-medium);
    line-height: 1.3;
    color: var(--ink);
  }

  .process-steps__body {
    margin: 0;
    font-size: var(--text-body-s);
    line-height: 1.6;
    color: var(--text);
  }

  @media (max-width: 36rem) {
    .process-steps__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
