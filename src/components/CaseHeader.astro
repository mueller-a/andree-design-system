---
/**
 * Kopf einer Case Study (Dark Studio). Reihenfolge im DOM = Leserichtung:
 * zuerst der Zurück-Link oben links, dann die Kennung, dann Titel und Summary.
 */
interface Props {
  title: string;
  client: string;
  summary: string;
  /** Laufende Nummer (aus order). */
  index: number;
  confidential?: boolean;
  backHref?: string;
  backLabel?: string;
}
const {
  title,
  client,
  summary,
  index,
  confidential,
  backHref = '/',
  backLabel = '← All work',
} = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
---

<header class="case-header">
  <a class="case-header__back caps caps--accent" href={backHref}>{backLabel}</a>

  <p class="case-header__kind caps caps--wide">
    Case study {pad(index)} &middot; {client}
  </p>

  <h1 class="case-header__title">{title}</h1>
  <p class="case-header__summary">{summary}</p>

  {
    confidential && (
      <p class="case-header__flag">
        <span class="caps">Confidential</span>
        Client work under NDA. You reached this with an access code. Some
        surfaces and figures are still abstracted.
      </p>
    )
  }
</header>

<style>
  .case-header {
    display: flex;
    flex-direction: column;
  }

  .case-header__back {
    align-self: flex-start;
    text-decoration: none;
    border-block-end: 1px solid transparent;
    padding-block-end: 4px;
  }

  .case-header__back:hover {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }

  .case-header__kind {
    margin: var(--space-6) 0 0;
  }

  .case-header__title {
    margin: var(--space-4) 0 0;
    max-width: 20ch;
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .case-header__summary {
    margin: var(--space-6) 0 0;
    max-width: 42ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text);
  }

  .case-header__flag {
    margin: var(--space-8) 0 0;
    max-width: 42ch;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--mark);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text);
  }

  .case-header__flag .caps {
    display: block;
    color: var(--ink);
  }
</style>
