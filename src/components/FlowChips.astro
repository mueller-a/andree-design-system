---
/**
 * Kette aus Prozess-Schritten, z. B. "Task flow → Prototype → Verify". Pfeile
 * sind rein dekorativ (aria-hidden); die Reihe selbst ist ein <ol>, damit die
 * Reihenfolge für Screenreader erhalten bleibt, auch ohne sichtbare Nummern.
 */
interface Props {
  chips: string[];
  /** Zeigt ein Loop-Symbol nach der letzten Chip, markiert die Kette als Zyklus. */
  loop?: boolean;
}
const { chips, loop = false } = Astro.props;
---

<ol class="flow-chips" role="list">
  {
    chips.map((chip, i) => (
      <li class="flow-chips__item">
        {i > 0 && (
          <span class="flow-chips__arrow" aria-hidden="true">
            →
          </span>
        )}
        <span class="flow-chips__chip">{chip}</span>
      </li>
    ))
  }
  {
    loop && (
      <li class="flow-chips__item" aria-hidden="true">
        <span class="flow-chips__loop">↻</span>
      </li>
    )
  }
</ol>

<style>
  .flow-chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .flow-chips__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .flow-chips__chip {
    padding: var(--space-2) var(--space-6);
    border: 1px solid var(--border-strong);
    font-size: 0.9375rem;
    color: var(--text);
  }

  .flow-chips__arrow {
    color: var(--accent);
  }

  .flow-chips__loop {
    font-family: var(--font-mono);
    font-size: var(--text-label-l);
    color: var(--accent);
  }
</style>
