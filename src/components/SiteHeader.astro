---
import ThemeToggle from './ThemeToggle.astro';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  /** Aktueller Pfad, für aria-current in der Navigation. */
  path: string;
  /** Name/Marke links im Header. */
  siteName: string;
  /** Hauptnavigation rechts. */
  nav: NavItem[];
}

const { path, siteName, nav } = Astro.props;

const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = norm(path);

const isCurrent = (href: string) => {
  if (href.startsWith('mailto:') || href.startsWith('http')) return false;
  const h = norm(href);
  if (h === '/') return current === '/' || current.startsWith('/work');
  return current === h || current.startsWith(h + '/');
};
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__mark" href="/" rel="home">{siteName}</a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-6);
  }

  .site-header__mark {
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header__mark:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-8);
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: 0;
  }

  .site-header__nav a {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--text);
    text-decoration: none;
    padding-block: var(--space-1);
  }

  .site-header__nav a:hover {
    color: var(--ink);
  }

  /* Aktiver Punkt: Akzentfarbe UND gelbe Unterkante – nicht nur Farbe. */
  .site-header__nav a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px 0 0 var(--mark);
  }
</style>
