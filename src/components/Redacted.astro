---
/**
 * Zeigt einen Bildbereich als Flächenraster statt einer echten Kundenoberfläche.
 * Für Case Studies mit `confidential: true`. Rendert bewusst KEIN Bild.
 */
interface Props {
  /** Was hier stünde, in einem Satz – ohne Kundendetails. */
  label?: string;
  caption?: string;
  /** aspect-ratio als CSS-Wert, z. B. "16 / 10". */
  ratio?: string;
}

const {
  label = 'Surface abstracted, client data removed',
  caption,
  ratio = '16 / 10',
} = Astro.props;
---

<figure class="redacted">
  <div class="redacted__area placeholder" style={`--ratio: ${ratio};`} role="img" aria-label={label}>
    <span class="redacted__label caps">{label}</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .redacted {
    margin-block: var(--space-12);
  }

  .redacted__area {
    aspect-ratio: var(--ratio, 16 / 10);
    color: var(--ink-muted);
  }

  .redacted__label {
    text-align: center;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
  }

  figcaption {
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-muted);
    max-width: var(--measure);
  }
</style>
