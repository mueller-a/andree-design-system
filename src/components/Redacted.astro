---
/**
 * Zeigt einen Bildbereich als Flächenraster statt einer echten Kundenoberfläche.
 * Für Case Studies mit `confidential: true`. Rendert bewusst KEIN Bild.
 */
interface Props {
  /** Was hier stünde, in einem Satz – ohne Kundendetails. */
  label?: string;
  caption?: string;
  /** aspect-ratio als CSS-Wert, z. B. "16 / 10". */
  ratio?: string;
}

const {
  label = 'Oberfläche abstrahiert, Kundendaten entfernt',
  caption,
  ratio = '16 / 10',
} = Astro.props;
---

<figure class="redacted">
  <div class="redacted__area" style={`--ratio: ${ratio};`} role="img" aria-label={label}>
    <span class="redacted__label">{label}</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .redacted {
    margin-block: var(--space-12);
  }

  .redacted__area {
    aspect-ratio: var(--ratio, 16 / 10);
    display: grid;
    place-items: center;
    padding: var(--space-8);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-muted);
    background-color: var(--surface-raised);
    background-image: repeating-linear-gradient(
      45deg,
      transparent 0,
      transparent 10px,
      var(--rule) 10px,
      var(--rule) 11px
    );
  }

  .redacted__label {
    font-size: var(--step--1);
    text-align: center;
    padding: var(--space-2) var(--space-4);
    background-color: var(--surface-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  figcaption {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: var(--measure);
  }
</style>
