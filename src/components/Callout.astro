---
/**
 * Varianten beschreiben nur die Darstellung, die Bedeutung trägt der Aufruf.
 * `default`: volle Breite, Text --ink in --text-body.
 * `quiet`: schmaler (--measure-narrow), Text --text in --text-body-xs.
 */
interface Props {
  label: string;
  variant?: 'default' | 'quiet';
}
const { label, variant = 'default' } = Astro.props;
---

<div class:list={['callout', `callout--${variant}`]}>
  <p class="callout__label">{label}</p>
  <div class="callout__body">
    <slot />
  </div>
</div>

<style>
  .callout {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-left: var(--rail) solid var(--mark);
    padding: var(--space-1) 0 var(--space-1) var(--space-6);
  }

  .callout__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-case-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .callout__body {
    line-height: 1.6;
  }

  .callout__body :global(p) {
    margin: 0;
  }

  .callout--default .callout__body {
    font-size: var(--text-body);
    color: var(--ink);
  }

  .callout--quiet {
    max-width: var(--measure-narrow);
  }

  .callout--quiet .callout__body {
    font-size: var(--text-body-xs);
    color: var(--text);
  }
</style>
