---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/**
 * Ausgewählte Arbeiten als Karten (Dark Studio): pro Karte ein einziger Link,
 * links Kennzeile (Kunde · Branche · Zeitraum), Titel, Summary, Rolle, Outcomes
 * und Tags, rechts das Cover. Bei `gate !== 'none'` bleibt ein beschriftetes
 * Flächenraster statt des echten Covers, unabhängig davon, ob der Kundenname
 * (`confidential`) genannt werden darf. Das Gate betrifft nur das Cover, die
 * Textfelder bleiben sichtbar.
 */
interface Props {
  entries: CollectionEntry<'work'>[];
  /** Überschrift-Ebene für die Kartentitel. */
  headingLevel?: 2 | 3;
}
const { entries, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<ul class="cards" role="list">
  {
    entries.map((entry) => (
      <li>
        <a class="card" href={`/work/${entry.id}`}>
          <div class="card__body">
            <p class="caps caps--accent card__kind">
              <span>{entry.data.client}</span> &middot; <span>{entry.data.sector}</span>{' '}
              &middot; <span>{entry.data.period}</span>
            </p>
            <Heading class="card__title">{entry.data.title}</Heading>
            <p class="card__summary">{entry.data.summary}</p>
            <p class="caps caps--faint card__role">{entry.data.role}</p>
            <ul class="card__outcomes" role="list">
              {entry.data.outcome.map((item) => (
                <li>
                  <span class="card__outcome-square" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {entry.data.tags.length > 0 && (
              <ul class="card__tags" role="list">
                {entry.data.tags.map((tag) => (
                  <li class="caps">{tag}</li>
                ))}
              </ul>
            )}
          </div>

          <div class="card__cover">
            {entry.data.gate !== 'none' ? (
              <span class="card__cover-abstract caps">
                Image restricted. Enter an access code to view it.
              </span>
            ) : (
              <>
                <Picture
                  src={entry.data.cover}
                  alt={entry.data.coverAlt}
                  formats={['avif', 'webp']}
                  fallbackFormat="png"
                  widths={[360, 680, 1000]}
                  sizes="(min-width: 64rem) 340px, 100vw"
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={
                    entry.data.coverDark
                      ? { class: 'card__cover-variant card__cover-variant--light' }
                      : undefined
                  }
                />
                {entry.data.coverDark && (
                  <Picture
                    src={entry.data.coverDark}
                    alt={entry.data.coverAlt}
                    formats={['avif', 'webp']}
                    fallbackFormat="png"
                    widths={[360, 680, 1000]}
                    sizes="(min-width: 64rem) 340px, 100vw"
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'card__cover-variant card__cover-variant--dark' }}
                  />
                )}
              </>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin: 0;
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--space-12);
    align-items: end;
    padding: var(--space-10);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--motion-base) var(--ease);
  }

  .card:hover {
    background: var(--bg-hover);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .card__kind {
    margin: 0;
  }

  /* Umbruch nur an den Trennpunkten, nie mitten in Kunde, Branche oder Zeitraum. */
  .card__kind span {
    white-space: nowrap;
  }

  .card__title {
    margin: 0;
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 40ch;
  }

  .card:hover .card__title {
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .card__summary {
    margin: 0;
    max-width: 52ch;
    color: var(--text);
    line-height: 1.6;
  }

  .card__role {
    margin: 0;
  }

  /* Ergebnisse zwischen Summary (step-0) und Tags (step--2), Marke wie in
     OutcomeList.astro, hier in --accent. */
  .card__outcomes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    max-width: 52ch;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink);
  }

  .card__outcomes li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .card__outcome-square {
    inline-size: 6px;
    block-size: 6px;
    background: var(--accent);
    flex: none;
    translate: 0 -2px;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }

  .card__tags li {
    border: 1px solid var(--border);
    padding: 5px 8px;
  }

  .card__cover {
    block-size: 190px;
    background: var(--placeholder);
    overflow: hidden;
  }

  .card__cover :global(picture),
  .card__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .card__cover-abstract {
    display: grid;
    place-items: center;
    block-size: 100%;
    padding: var(--space-4);
    text-align: center;
    color: var(--text);
  }

  /* Hell/Dunkel-Cover, gegenläufig zum Seiten-Theme wie bei Figure.astro und
     CaseStudy.astro: coverDark im Light Mode, cover im Dark Mode. */
  .card__cover :global(picture.card__cover-variant--light) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) picture.card__cover-variant--dark) {
      display: none;
    }
    :global(:root:not([data-theme='light']) picture.card__cover-variant--light) {
      display: block;
    }
  }

  :global(:root[data-theme='dark'] picture.card__cover-variant--dark) {
    display: none;
  }
  :global(:root[data-theme='dark'] picture.card__cover-variant--light) {
    display: block;
  }

  @media (max-width: 64rem) {
    .card {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      align-items: stretch;
    }

    .card__cover {
      block-size: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
