---
/**
 * "Outcome" – steht in jeder Case Study oben, direkt nach dem Leitbild.
 * Zweispaltig: Mono-Marke links, die Punkte rechts mit gelbem Quadrat.
 */
interface Props {
  items: string[];
  headingLevel?: 2 | 3;
}
const { items, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<section class="outcome">
  <Heading class="outcome__mark caps caps--wide">Outcome</Heading>
  <ul class="outcome__list" role="list">
    {
      items.map((item) => (
        <li class="outcome__item">
          <span class="outcome__square" aria-hidden="true" />
          <span class="outcome__text">{item}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .outcome {
    display: grid;
    grid-template-columns: var(--meta-col) minmax(0, 1fr);
    gap: var(--space-14);
    align-items: start;
  }

  .outcome__mark {
    margin: 0;
    padding-block-start: var(--space-2);
  }

  .outcome__list {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .outcome__item {
    display: flex;
    gap: var(--space-6);
    align-items: baseline;
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--rule);
  }

  .outcome__square {
    inline-size: 8px;
    block-size: 8px;
    background: var(--signal);
    flex: none;
    translate: 0 -1px;
  }

  .outcome__text {
    font-size: var(--step-2);
    font-weight: var(--weight-subhead);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  @media (max-width: 48rem) {
    .outcome {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .outcome__mark {
      padding-block-start: 0;
    }
  }
</style>
