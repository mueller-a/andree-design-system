---
import { footerNav, site } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__contact">
      <p class="site-footer__lead">Kontakt</p>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="site-footer__note">
        Fragen zu Barrierefreiheit oder eine ausführlichere Projektfassung:
        gern per E-Mail.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Rechtliches">
      <ul role="list">
        {
          footerNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="site-footer__meta">
      © {year} {site.name}. Gebaut nach WCAG&nbsp;2.2&nbsp;AA – siehe
      <a href="/accessibility">Barrierefreiheit</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-32);
    border-block-start: 1px solid var(--rule);
    background-color: var(--surface-raised);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-16);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__meta {
      grid-column: 1 / -1;
    }
  }

  .site-footer__lead {
    font-family: var(--font-display);
    font-weight: 620;
  }

  .site-footer__contact p + p {
    margin-block-start: var(--space-2);
  }

  .site-footer__note {
    max-width: 44ch;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .site-footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__nav a {
    color: var(--ink-muted);
  }

  .site-footer__nav a:hover {
    color: var(--ink);
  }

  .site-footer__meta {
    font-size: var(--step--1);
    color: var(--ink-muted);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--rule);
  }
</style>
