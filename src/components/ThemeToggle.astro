---
/**
 * Gewöhnlicher Button, der das Design wechselt, kein Umschalter mit
 * `aria-pressed`. Der sichtbare Text nennt das aktive Design („Dark" /
 * „Light") und ist zusammen mit dem 8px-Punkt in --mark der nicht-farbliche
 * Zustandsträger. Ein visuell verstecktes Suffix ergänzt die Aktion, so dass
 * der zugängliche Name den sichtbaren Text enthält (2.5.3 Label in Name) und
 * sagt, was passiert: „Dark theme, switch to light".
 *
 * Standard ist dunkel; hell nur per Wahl oder Systemeinstellung. Label und
 * Aktion werden beim Laden mit dem tatsächlich wirksamen Design abgeglichen.
 * Die Beschriftungen erreichen das Modul-Skript als data-Attribute, ohne
 * Inline-Skript.
 */
interface Props {
  /** Beschriftungen, Standard englisch. Für anderssprachige Projekte überschreibbar. */
  labels?: { dark: string; light: string; switchToDark: string; switchToLight: string };
}
const {
  labels = {
    dark: 'Dark',
    light: 'Light',
    switchToDark: 'theme, switch to dark',
    switchToLight: 'theme, switch to light',
  },
} = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-dark={labels.dark}
  data-label-light={labels.light}
  data-label-switch-to-dark={labels.switchToDark}
  data-label-switch-to-light={labels.switchToLight}
>
  <span class="theme-toggle__dot" aria-hidden="true"></span>
  <span data-theme-toggle-label>{labels.dark}</span>
  <span class="visually-hidden" data-theme-toggle-action>{labels.switchToLight}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    transition: color var(--motion-base) var(--ease),
      border-color var(--motion-base) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--mark);
  }

  .theme-toggle__dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background: var(--mark);
    flex: none;
  }
</style>

<script>
  // Gebündelt als externes Modul (script-src 'self'), kein Inline-Skript.
  const STORAGE_KEY = 'theme';
  const buttons = document.querySelectorAll('[data-theme-toggle]');

  // Spiegelt exakt die Regeln in tokens.css: explizite Wahl gewinnt,
  // sonst hell nur bei prefers-color-scheme: light, sonst dunkel (Default).
  const effectiveTheme = () => {
    const explicit = document.documentElement.dataset.theme;
    if (explicit === 'light' || explicit === 'dark') return explicit;
    return window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  };

  // Label nennt das aktive Design, der versteckte Aktionstext das Ziel.
  // Beide aus den data-Attributen des jeweiligen Buttons.
  const sync = () => {
    const isDark = effectiveTheme() === 'dark';
    buttons.forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      const { labelDark, labelLight, labelSwitchToDark, labelSwitchToLight } = btn.dataset;
      const label = btn.querySelector('[data-theme-toggle-label]');
      const action = btn.querySelector('[data-theme-toggle-action]');
      if (label) label.textContent = (isDark ? labelDark : labelLight) ?? '';
      if (action) action.textContent = (isDark ? labelSwitchToLight : labelSwitchToDark) ?? '';
    });
  };

  const toggle = () => {
    const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      /* ohne Persistenz gilt der Wechsel für diese Sitzung */
    }
    sync();
  };

  buttons.forEach((btn) => btn.addEventListener('click', toggle));

  window
    .matchMedia('(prefers-color-scheme: light)')
    .addEventListener('change', () => {
      let stored;
      try {
        stored = localStorage.getItem(STORAGE_KEY);
      } catch {
        stored = null;
      }
      if (stored !== 'light' && stored !== 'dark') sync();
    });

  sync();
</script>
