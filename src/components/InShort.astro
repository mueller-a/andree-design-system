---
/** Maximal 3 Punkte, zur Build-Zeit geprüft. */
interface Props {
  points: string[];
  /** Sichtbares Label über der Liste. Auf anderssprachigen Seiten übersetzen. */
  label?: string;
}
const { points, label = 'In short' } = Astro.props;
if (points.length > 3) {
  throw new Error(
    `InShort: maximal 3 Punkte, ${points.length} übergeben. Für längere Listen eine normale Liste in Prose verwenden.`,
  );
}
---

<div class="in-short">
  <p class="in-short__label">{label}</p>
  <ul class="in-short__list" role="list">
    {
      points.map((point) => (
        <li>
          <span class="in-short__dot" aria-hidden="true" />
          {point}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .in-short {
    background: var(--surface);
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .in-short__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-case-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .in-short__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-body-s);
    line-height: 1.5;
    color: var(--ink);
  }

  .in-short__list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: var(--space-3);
  }

  .in-short__dot {
    width: 9px;
    height: 9px;
    margin-top: var(--space-2);
    background: var(--mark);
  }
</style>
