---
/**
 * Envisioned-Journey-Phasen als Chevron-Kette in einem Surface-Panel.
 * Siehe DESIGN_SYSTEM_SPEC.md (DMPK-Handoff), Referenz "Journey Options.dc.html"
 * Variante 1c. Chevron-Form ist rein dekorativ (CSS clip-path), die
 * Reihenfolge der Phasen steckt im `<ol>`.
 */
interface Phase {
  num: string;
  phase: string;
  steps: string[];
  who: string;
}
interface Props {
  journey: Phase[];
}
const { journey } = Astro.props;
---

<div class="journey-strip">
  <ol class="journey-strip__grid" role="list">
    {
      journey.map((phase) => (
        <li class="journey-strip__item">
          <div class="journey-strip__chevron">
            <span class="journey-strip__num">{phase.num}</span>
            <span class="journey-strip__phase">{phase.phase}</span>
          </div>
          <ul class="journey-strip__steps" role="list">
            {phase.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ul>
          <span class="journey-strip__who">{phase.who}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .journey-strip {
    background: var(--surface);
    padding: 2rem 1.75rem 1.75rem;
  }

  .journey-strip__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: 1.25rem 0.25rem;
  }

  .journey-strip__item {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  /* Chevron-Form rein dekorativ (clip-path), Textfarbe in beiden Themes
     hart auf die dunkle Tinte gesetzt, weil die Fläche selbst immer --mark
     (Gelb) ist, unabhängig vom Theme. Kontrast geprüft: 9.85:1 (dark
     --mark #f5c518) und 7.93:1 (light --mark #e0b000), beide >= 4.5:1. */
  .journey-strip__chevron {
    background: var(--mark);
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 50%, calc(100% - 22px) 100%, 0 100%, 22px 50%);
    padding: 1.25rem 1.5rem 1.25rem 1.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: #14232d;
  }

  .journey-strip__num {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-case-caps-date);
    font-weight: var(--weight-medium);
  }

  .journey-strip__phase {
    font-size: 1.125rem;
    font-weight: var(--weight-medium);
  }

  .journey-strip__steps {
    margin: 0;
    padding: 0 1rem 0 1.375rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--text);
  }

  .journey-strip__who {
    margin: auto 1rem 0 1.375rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
