---
/**
 * Für Personas, Formate oder andere kurze, gleichförmige Karten.
 * `title` ist optional: ohne Titel läuft `body` in --text statt --muted,
 * siehe Spec 2.12.
 */
interface Card {
  eyebrow: string;
  title?: string;
  body: string;
}
interface Props {
  items: Card[];
}
const { items } = Astro.props;
---

<div class="card-grid">
  {
    items.map((item) => (
      <div class="card-grid__card">
        <span class="card-grid__eyebrow">{item.eyebrow}</span>
        {item.title && <span class="card-grid__title">{item.title}</span>}
        <span class:list={['card-grid__body', { 'card-grid__body--plain': !item.title }]}>
          {item.body}
        </span>
      </div>
    ))
  }
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1px;
    background: var(--border);
  }

  .card-grid__card {
    background: var(--surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-grid__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-case-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .card-grid__title {
    font-size: var(--text-title-s);
    font-weight: var(--weight-medium);
    color: var(--ink);
    line-height: 1.3;
  }

  .card-grid__body {
    font-size: var(--text-body-xs);
    line-height: 1.55;
    color: var(--muted);
  }

  .card-grid__body--plain {
    color: var(--text);
  }
</style>
