---
/**
 * Zeigt den Slot-Inhalt zweimal nebeneinander, einmal je erzwungenem Theme
 * (siehe tokens.css: [data-theme] greift auch verschachtelt, nicht nur auf
 * <html>). Nur für /design-system.
 */
---

<div class="theme-preview">
  <div class="theme-preview__pane" data-theme="dark">
    <p class="theme-preview__tag">Dark</p>
    <div class="theme-preview__surface">
      <slot />
    </div>
  </div>
  <div class="theme-preview__pane" data-theme="light">
    <p class="theme-preview__tag">Light</p>
    <div class="theme-preview__surface">
      <slot />
    </div>
  </div>
</div>

<style>
  .theme-preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .theme-preview__pane {
    background: var(--bg);
    padding: var(--space-8);
  }

  .theme-preview__tag {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .theme-preview__surface {
    color: var(--text);
  }
</style>
