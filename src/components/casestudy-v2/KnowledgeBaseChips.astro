---
interface Props {
  chips: string[];
  /** Kurzer Kontext, was die Knowledge Base ist und wofür sie da ist. */
  description?: string;
}
const { chips, description } = Astro.props;
---

<div class="kb-chips">
  <div class="kb-chips__head">
    <p class="kb-chips__label">Knowledge base</p>
    {description && <p class="kb-chips__description">{description}</p>}
  </div>
  <ul class="kb-chips__list" role="list">
    {chips.map((chip) => <li class="kb-chips__chip">{chip}</li>)}
  </ul>
</div>

<style>
  .kb-chips {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .kb-chips__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .kb-chips__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .kb-chips__description {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--text);
  }

  .kb-chips__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .kb-chips__chip {
    font-size: var(--step--1);
    padding: 7px 12px;
    border: 1px solid var(--border);
    color: var(--text);
  }
</style>
