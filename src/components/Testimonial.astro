---
interface Quote {
  quote: string;
  role: string;
}
interface Props {
  items: Quote[];
}
const { items } = Astro.props;
---

<div class="testimonial">
  {
    items.map((item) => (
      <figure class="testimonial__item">
        <span class="testimonial__mark" aria-hidden="true">
          “
        </span>
        <blockquote class="testimonial__quote">
          <p>{item.quote}</p>
        </blockquote>
        <figcaption class="testimonial__role">
          <span class="testimonial__role-line" aria-hidden="true" />
          {item.role}
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: var(--space-4) 0;
    border-top: 1px solid var(--border);
  }

  .testimonial__item {
    margin: 0;
    padding: var(--space-12) 0 var(--space-10);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: var(--space-2) var(--space-6);
  }

  /* Anführungszeichen ist rein dekorativ (aria-hidden) -> --mark, nicht --accent. */
  .testimonial__mark {
    font-weight: var(--weight-subhead);
    font-size: 120px;
    line-height: 0.8;
    height: 3.5rem;
    color: var(--mark);
  }

  .testimonial__quote {
    margin: 0;
  }

  .testimonial__quote p {
    margin: 0;
    font-weight: var(--weight-subhead);
    font-size: var(--text-quote);
    line-height: 1.22;
    letter-spacing: var(--tracking-case-quote);
    color: var(--ink);
    text-wrap: pretty;
  }

  .testimonial__role {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-case-caps);
    color: var(--accent);
  }

  /* Strich vor der Rolle ist ebenfalls dekorativ -> --mark. */
  .testimonial__role-line {
    width: var(--space-8);
    height: 1px;
    background: var(--mark);
  }

  @media (max-width: 40rem) {
    .testimonial__item {
      grid-template-columns: 48px minmax(0, 1fr);
    }

    .testimonial__mark {
      font-size: 80px;
    }
  }
</style>
