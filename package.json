{
  "name": "@andree/design-system",
  "version": "0.3.0",
  "type": "module",
  "description": "Dark Studio: tokens, Astro components and layouts shared across Andree Müller's sites.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mueller-a/andree-design-system.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "src/components",
    "src/layouts",
    "src/lib",
    "src/styles",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./styles/*.css": "./src/styles/*.css",
    "./components/*.astro": "./src/components/*.astro",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./lib/*": "./src/lib/*.ts",
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "pnpm check && pnpm lint && pnpm build && pnpm docs:build && pnpm docs:check && pnpm a11y",
    "a11y": "node scripts/a11y.mjs",
    "docs:build": "node scripts/docs-build.mjs"
  },
  "peerDependencies": {
    "astro": "^5.14.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.14",
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.45.0",
    "astro": "^5.14.1",
    "eslint": "^9.36.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "1.63.0",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
